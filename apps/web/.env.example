# SQLite file for local dev. Swap for a libsql/Turso URL or move to @payloadcms/db-postgres in production.
DATABASE_URL=file:./payload.db
# Long random string. Rotate per environment.
PAYLOAD_SECRET=change-me
# Public origin, used for absolute URLs and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Seed admin login (only used by `pnpm seed`).
SEED_ADMIN_EMAIL=admin@pixeldev.com.au
SEED_ADMIN_PASSWORD=change-me
# Postmark (transactional email). Leave the token blank in dev to log emails to the console instead.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
# Must be a verified Sender Signature or on a verified domain in Postmark.
EMAIL_FROM_ADDRESS=liam@pixeldev.com.au
EMAIL_FROM_NAME=Pixeldev
# Where contact form enquiries are emailed. Defaults to the email in Site settings.
ENQUIRY_NOTIFY_TO=
